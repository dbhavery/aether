# =============================================================================
# Aether — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# Only ANTHROPIC_API_KEY and GOOGLE_API_KEY are required for core LLM features.
# All other keys are optional and enable specific integrations.
# =============================================================================

# --- LLM Providers (required for core functionality) ---
ANTHROPIC_API_KEY=            # Anthropic Claude API key
GOOGLE_API_KEY=               # Google Gemini API key

# --- LLM Providers (optional) ---
OPENAI_API_KEY=               # OpenAI API key (optional LLM fallback)

# --- Voice I/O ---
ELEVENLABS_API_KEY=           # ElevenLabs API key (Scribe STT + Flash TTS fallback)
PICOVOICE_ACCESS_KEY=         # Picovoice Porcupine wake word engine

# --- Notifications ---
TELEGRAM_BOT_TOKEN=           # Telegram bot token for remote messaging
TELEGRAM_CHAT_ID=             # Your Telegram chat ID (get from @userinfobot)
FIREBASE_SERVICE_ACCOUNT_PATH=  # Path to Firebase service account JSON (FCM push notifications)

# --- Tools & Integrations ---
GITHUB_TOKEN=                 # GitHub personal access token (repo operations, issues)
TAVILY_API_KEY=               # Tavily web search API key (research agent)
GOOGLE_OAUTH_CLIENT_PATH=     # Path to Google OAuth client JSON (Calendar, Gmail, etc.)

# --- Data & Server ---
AETHER_DATA_PATH=./data       # Root directory for persistent data (embeddings, DBs, logs)
CHROMA_PATH=./data/chroma     # ChromaDB vector store path
OBSIDIAN_VAULT=./docs/vault   # Obsidian vault path (optional)
WEBSOCKET_PORT=8765           # WebSocket server port
HEALTH_PORT=8767              # Health check HTTP port
DATA_SERVER_PORT=8766         # Data server port
SERVER_HOST=127.0.0.1         # Server bind address
OLLAMA_BASE_URL=http://localhost:11434  # Ollama API endpoint

# --- Mobile ---
ANDROID_DEVICE_TOKEN=         # Android device FCM token (for push notifications)

# --- Advanced ---
LOG_LEVEL=DEBUG               # Logging level (DEBUG, INFO, WARNING, ERROR)
AETHER_ENV_PATH=              # Override .env file path (advanced)
