# Environment
.env
.env.*
!.env.example
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Models and large files
models/
*.wav
*.mp3
*.onnx
*.bin
*.safetensors
# Persona pack audio is a REQUIRED ship asset (reference.wav + sample.wav
# per PERSONA-SCHEMA.md §1). The persona-generator's landmark cache and
# LivePortrait-rendered clips stay ignored via the separate paths below.
!personas/*/voice/*.wav
personas/*/avatar/clips/
personas/*/avatar/landmarks.json
# Reference-image batches. Manifests can be
# large; live batches accumulate dozens of MB per persona. Curation
# verdicts (curation.jsonl) and selftest results (selftest.jsonl) are
# regenerable, not load-bearing as repo artifacts.
personas/*/_pipeline/

# Data
data/
!android/**/data/
*.db
*.sqlite

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

