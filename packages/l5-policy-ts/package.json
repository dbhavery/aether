{
  "name": "@aether/l5-policy-ts",
  "version": "0.0.1",
  "private": true,
  "description": "Aether L5 TypeScript facade. Types-only mirror of the Rust surface in `packages/l5-policy`. Will be regenerated by tools/ts-bindings-gen in Wave 2+.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./commands": "./src/commands.ts",
    "./decision": "./src/decision.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aether/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
